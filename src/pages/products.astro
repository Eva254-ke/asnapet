---
import Layout from '../layout/Layout.astro';
import PackShot from '../components/PackShot.astro';
import { categories, categoryNames } from '../data/categories';
import { waLinks, business } from '../data/site';
---

<Layout
  title="Our Products - Asnapet Treasures"
  description="Browse Asnapet Treasures product categories: energy drinks, fruit juices and soft drinks, cereals, dairy products, sauces, snacks and canned foods."
  itemList={categoryNames}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products' },
  ]}
>
  <section class="category-header">
    <div class="container category-header__container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Products</li>
        </ol>
      </nav>

      <span class="eyebrow">Our Products</span>
      <h1 class="category-header__title">Our Products</h1>
      <p class="category-header__subtitle">
        Asnapet Treasures specializes in distributing a wide variety of food and beverage products, including:
      </p>
      <div class="category-header__actions">
        <a href={waLinks.fullCatalog} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Request Full Catalog
        </a>
        <a href={`tel:${business.phone}`} class="btn btn-ghost">Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="category-content section-lazy" aria-labelledby="products-grid-title">
    <div class="container">
      <div class="section-heading section-heading--left" data-reveal>
        <span class="eyebrow">Available categories</span>
        <h2 id="products-grid-title">Our Products</h2>
        <p>
          Asnapet Treasures specializes in distributing a wide variety of food and beverage products, including:
        </p>
      </div>

      <div class="subcategory-grid">
        {
          categories.map((group, index) => (
            <a
              class="subcategory-card"
              href={group.href}
              data-reveal
              data-reveal-delay={String((index % 3) + 1)}
            >
              <div class="subcategory-card__media">
                <PackShot
                  icon={group.icon}
                  image={group.image}
                  alt={group.alt}
                  class="subcategory-card__image"
                  widths={[240, 400, 600, 800]}
                  sizes="(max-width: 1080px) 50vw, 33vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  tileClass={index % 2 === 1 ? 'packshot--warm' : undefined}
                />
              </div>
              <div class="subcategory-card__content">
                <h3 class="subcategory-card__title">{group.title}</h3>
                <p class="subcategory-card__text">{group.detail}</p>
                <span class="subcategory-card__link">
                  Enquire
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <section class="category-cta" aria-labelledby="products-cta-title">
        <span class="eyebrow">Not listed above?</span>
        <h2 class="category-cta__title" id="products-cta-title">
          Tell us what you need and we will source it.
        </h2>
        <p class="category-cta__text">
          Our supplier network covers more items than this page lists. Send the product name, size,
          preferred brand and quantity, and we will confirm availability, pricing and delivery timing.
        </p>
        <a href={waLinks.quote} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          Send your list on WhatsApp
        </a>
      </section>
    </div>
  </section>
</Layout>



