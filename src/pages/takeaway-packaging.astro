---
import Layout from '../layout/Layout.astro';
import PackShot from '../components/PackShot.astro';
import { waLinks, business } from '../data/site';
import type { PackIcon } from '../data/categories';

import takeawayHero from '../assets/images/pack-takeaway-hero.webp';

/**
 * Five of the six lines below are the same products as the matching entries in
 * categories.ts, so they deliberately share those photos rather than introduce
 * near-duplicate images of the same thing. Only the lunch box shot is specific
 * to this page.
 */
import clamshells from '../assets/images/pack-takeaway-containers.jpg';
import lunchBoxes from '../assets/images/pack-lunch-boxes.webp';
import cupsLidsStraws from '../assets/images/pack-cups-lids-straws.webp';
import carrierBags from '../assets/images/pack-paper-bags.webp';
import cutleryNapkins from '../assets/images/pack-cutlery-serviceware.webp';
import brandedPackaging from '../assets/images/pack-labels-branding.webp';

const heroHighlights = ['Clamshells', 'Lunch boxes', 'Cups & lids', 'Carrier bags'];

/**
 * Takeaway-specific lines. Photos are added the same way as in categories.ts:
 * import the file, then set `image` and `alt` on the entry.
 */
const subcategories: {
  title: string;
  description: string;
  icon: PackIcon;
  image?: ImageMetadata;
  alt?: string;
  items: string[];
}[] = [
  {
    title: 'Hinged Clamshells',
    description: 'Single and multi-compartment clamshells that close without a separate lid.',
    icon: 'container',
    image: clamshells,
    alt: 'Stacked bagasse clamshell boxes, one open with a compartmented meal inside',
    items: ['Bagasse', 'Plastic', 'Compartment'],
  },
  {
    title: 'Lunch Boxes & Bowls',
    description: 'Sealable boxes and round bowls for rice, stews, salads and hot mains.',
    icon: 'container',
    image: lunchBoxes,
    alt: 'Kitchen worker carrying a stack of kraft lunch boxes topped with a lidded soup cup',
    items: ['Sealable lids', 'Round bowls', 'Deep boxes'],
  },
  {
    title: 'Cups, Lids & Straws',
    description: 'Hot and cold drink cups with matching lids, sleeves and paper straws.',
    icon: 'cup',
    image: cupsLidsStraws,
    alt: 'Three logo-printed drink cups with dome and sip lids and a straw',
    items: ['Paper cups', 'PET cups', 'Dome lids'],
  },
  {
    title: 'Carrier & Kraft Bags',
    description: 'Handled carrier bags and kraft bags that hold a full order without tearing.',
    icon: 'bag',
    image: carrierBags,
    alt: 'A plain kraft paper carrier bag with twisted paper handles',
    items: ['Twisted handle', 'Flat kraft', 'Grease-resistant'],
  },
  {
    title: 'Cutlery & Napkins',
    description: 'Wooden and plastic cutlery, serviettes, portion cups and food gloves.',
    icon: 'cutlery',
    image: cutleryNapkins,
    alt: 'Wooden sporks standing in a holder beside folded napkin wraps',
    items: ['Wooden cutlery', 'Serviettes', 'Portion cups'],
  },
  {
    title: 'Branded Packaging',
    description: 'Your logo printed onto cups, bags, containers, labels and tamper seals.',
    icon: 'label',
    image: brandedPackaging,
    alt: 'Rolls of printed labels beside coffee bags, jars and tubs wearing the finished labels',
    items: ['Printed cups', 'Logo bags', 'Tamper seals'],
  },
];

const serviceSteps = [
  { title: 'Tell us what you pack', text: 'Share the dishes and portion sizes you send out.' },
  { title: 'We confirm the grade', text: 'We match the packaging to hot, oily, wet or frozen food.' },
  { title: 'Samples, then supply', text: 'Test it with your own food, then order plain or branded.' },
];
---

<Layout
  title="Takeaway Packaging in Nairobi — Containers, Cups & Carrier Bags"
  description="Takeaway packaging from Asnapet Treasures: hinged clamshells, lunch boxes, bowls, cups and lids, carrier bags, cutlery and custom-branded packaging. Supplied across Nairobi with samples before you commit."
  itemList={subcategories.map((s) => s.title)}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Takeaway Packaging', path: '/takeaway-packaging' },
  ]}
>
  <header class="category-header category-header--segment">
    <div class="container category-header__container segment-hero">
      <div class="segment-hero__copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Takeaway Packaging</li>
          </ol>
        </nav>

        <span class="eyebrow">Takeaway range</span>
        <h1 class="category-header__title">Packaging that survives the trip to your customer.</h1>
        <p class="category-header__subtitle">
          Clamshells, lunch boxes, bowls, cups, carrier bags and cutlery for restaurants, cafes and
          delivery kitchens &mdash; with the grade checked against the food you actually send out.
        </p>
        <div class="segment-hero__actions">
          <a href={waLinks.takeaway} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            Request Takeaway Catalog
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a href="#segment-sections" class="btn btn-ghost">Browse Range</a>
        </div>
      </div>

      <div class="segment-hero__visual" aria-label="Featured takeaway packaging">
        <PackShot
          icon="container"
          image={takeawayHero}
          alt="Kraft carrier bag, capped drink bottles, soup cups, a noodle box and wooden cutlery"
          class="segment-hero__image"
          widths={[400, 640, 900]}
          sizes="(max-width: 980px) 100vw, 42vw"
          loading="eager"
          tileClass="packshot--hero"
        />
        <div class="segment-hero__panel">
          <span>Popular lines</span>
          <div class="segment-hero__chips">
            {heroHighlights.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="category-content section-lazy segment-content" aria-labelledby="segment-sections">
    <div class="container">
      <div class="section-heading section-heading--left segment-heading" data-reveal>
        <span class="eyebrow">Available lines</span>
        <h2 id="segment-sections">Takeaway packaging grouped for faster ordering.</h2>
        <p>
          Browse the main lines, then send the list you need so we can confirm sizes, current
          availability and whether a branded version is worth it at your volume.
        </p>
      </div>

      <div class="subcategory-grid subcategory-grid--segment">
        {
          subcategories.map((sub, index) => (
            <article
              class="subcategory-card segment-card"
              data-reveal
              data-reveal-delay={String((index % 3) + 1)}
            >
              <div class="subcategory-card__media">
                <PackShot
                  icon={sub.icon}
                  image={sub.image}
                  alt={sub.alt}
                  class="subcategory-card__image"
                  widths={[240, 400, 600, 800]}
                  sizes="(max-width: 1080px) 50vw, 33vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  tileClass={index % 2 === 1 ? 'packshot--warm' : undefined}
                />
              </div>
              <div class="subcategory-card__content segment-card__content">
                <span class="segment-card__label">Takeaway line</span>
                <h3 class="subcategory-card__title">{sub.title}</h3>
                <p class="subcategory-card__text">{sub.description}</p>
                <div class="segment-card__items" aria-label={`${sub.title} examples`}>
                  {sub.items.map((item) => <span>{item}</span>)}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <section class="segment-service" aria-labelledby="segment-service-title">
        <div class="section-heading section-heading--left segment-service__heading" data-reveal>
          <span class="eyebrow">How it works</span>
          <h2 id="segment-service-title">A simple way to get the packaging right first time.</h2>
        </div>
        <div class="segment-service__steps">
          {
            serviceSteps.map((step, index) => (
              <article class="segment-step" data-reveal data-reveal-delay={String(index + 1)}>
                <span class="segment-step__number">0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="category-cta category-cta--segment" aria-labelledby="category-cta-title">
        <span class="eyebrow">Need something specific?</span>
        <h2 class="category-cta__title" id="category-cta-title">
          Send your list and we will confirm sizes and pricing.
        </h2>
        <p class="category-cta__text">
          Tell us the dishes you send out and roughly how many covers a week. We will recommend sizes,
          quote plain and branded options, and arrange samples first. Free delivery on orders over{' '}
          {business.freeDeliveryThreshold} within Nairobi.
        </p>
        <a href={waLinks.samples} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          Request samples on WhatsApp
        </a>
      </section>
    </div>
  </section>
</Layout>
