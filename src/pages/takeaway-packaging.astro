---
import Layout from '../layout/Layout.astro';
import PackShot from '../components/PackShot.astro';
import { categories, categoryNames } from '../data/categories';
import { waLinks, business } from '../data/site';

const featured = categories.slice(0, 6);
const orderSteps = [
  { title: 'Send your list', text: 'Share product names, sizes, brand preferences and quantities.' },
  { title: 'We confirm stock', text: 'We check availability, pricing and suitable alternatives where needed.' },
  { title: 'Delivery is arranged', text: 'Once confirmed, we coordinate payment and delivery around Nairobi.' },
];
---

<Layout
  title="Product Supply in Nairobi - Food, Drinks & Essentials"
  description="Asnapet Treasures supplies food, beverages, cereals, grains, dairy products, snacks, canned foods and household essentials to Nairobi customers."
  itemList={categoryNames}
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Product Supply', path: '/takeaway-packaging' },
  ]}
>
  <header class="category-header category-header--segment">
    <div class="container category-header__container segment-hero">
      <div class="segment-hero__copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Product Supply</li>
          </ol>
        </nav>

        <span class="eyebrow">Product supply</span>
        <h1 class="category-header__title">Reliable food and beverage supply for Nairobi buyers.</h1>
        <p class="category-header__subtitle">
          Asnapet Treasures helps shops, hotels, restaurants, offices and homes source everyday
          products with clear availability checks, practical pricing and responsive delivery support.
        </p>
        <div class="segment-hero__actions">
          <a href={waLinks.fullCatalog} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            Request Product Catalog
          </a>
          <a href="/products" class="btn btn-ghost">Browse Products</a>
        </div>
      </div>

      <div class="segment-hero__visual" aria-label="Featured food and beverage supply categories">
        <PackShot
          icon="bottle"
          image={featured[0]?.image}
          alt={featured[0]?.alt}
          class="segment-hero__image"
          widths={[400, 640, 900]}
          sizes="(max-width: 980px) 100vw, 42vw"
          loading="eager"
          tileClass="packshot--hero"
        />
        <div class="segment-hero__panel">
          <span>Popular categories</span>
          <div class="segment-hero__chips">
            {featured.slice(0, 4).map((item) => <span>{item.title}</span>)}
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="category-content section-lazy segment-content" aria-labelledby="segment-sections">
    <div class="container">
      <div class="section-heading section-heading--left segment-heading" data-reveal>
        <span class="eyebrow">Available categories</span>
        <h2 id="segment-sections">Core product lines for repeat ordering.</h2>
        <p>
          These are the main categories customers request most often. Send your list and we will
          confirm current brands, sizes and delivery timing before you commit.
        </p>
      </div>

      <div class="subcategory-grid subcategory-grid--segment">
        {
          featured.map((sub, index) => (
            <article
              class="subcategory-card segment-card"
              data-reveal
              data-reveal-delay={String((index % 3) + 1)}
            >
              <div class="subcategory-card__media">
                <PackShot
                  icon={sub.icon}
                  image={sub.image}
                  alt={sub.alt}
                  class="subcategory-card__image"
                  widths={[240, 400, 600, 800]}
                  sizes="(max-width: 1080px) 50vw, 33vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  tileClass={index % 2 === 1 ? 'packshot--warm' : undefined}
                />
              </div>
              <div class="subcategory-card__content segment-card__content">
                <span class="segment-card__label">Supply category</span>
                <h3 class="subcategory-card__title">{sub.title}</h3>
                <p class="subcategory-card__text">{sub.detail}</p>
              </div>
            </article>
          ))
        }
      </div>

      <section class="segment-service" aria-labelledby="segment-service-title">
        <div class="section-heading section-heading--left segment-service__heading" data-reveal>
          <span class="eyebrow">How it works</span>
          <h2 id="segment-service-title">A simple way to place repeat orders.</h2>
        </div>
        <div class="segment-service__steps">
          {
            orderSteps.map((step, index) => (
              <article class="segment-step" data-reveal data-reveal-delay={String(index + 1)}>
                <span class="segment-step__number">0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="category-cta category-cta--segment" aria-labelledby="category-cta-title">
        <span class="eyebrow">Need something specific?</span>
        <h2 class="category-cta__title" id="category-cta-title">
          Send your shopping list and we will confirm what can be supplied.
        </h2>
        <p class="category-cta__text">
          Message us with item names, pack sizes and quantities. We serve Nairobi customers from
          {business.street} and arrange delivery across nearby areas.
        </p>
        <a href={waLinks.quote} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          Send your list on WhatsApp
        </a>
      </section>
    </div>
  </section>
</Layout>



