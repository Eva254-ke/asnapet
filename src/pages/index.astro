---
import Layout from '../layout/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Products from '../components/Products.astro';
import Faq from '../components/Faq.astro';
import { categoryNames } from '../data/categories';
---

<Layout
  title="Food & Beverage Packaging Supplier in Nairobi"
  description="Asnapet Treasures supplies food and beverage packaging across Nairobi — takeaway containers, cups and lids, bottles, pouches, paper bags and bakery cartons, plain or printed with your own branding. Samples available, M-Pesa accepted."
  itemList={categoryNames}
  includeFaq={true}
>
  <Hero />
  <Products />
  <About />
  <Faq />
</Layout>
