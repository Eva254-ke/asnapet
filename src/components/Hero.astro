---
import { Image } from 'astro:assets';
import { waLinks } from '../data/site';
import heroImage from '../assets/images/istockphoto-1254418154-170667a.jpg';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- A real <img> rather than a CSS background: it can carry a srcset, be
       served as WebP/AVIF, and is discoverable by the preload scanner, which
       matters because this is the LCP element. -->
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    aria-hidden="true"
    widths={[480, 768, 1200, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <div class="hero__media" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__container">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-main">Asnapet</span>
        <span class="hero__title-accent">Treasures</span>
      </h1>

      <p class="hero__subtitle">
        Quality farm inputs, household essentials and practical daily goods supplied across Nairobi
        &mdash; with clear availability checks and direct WhatsApp support.
      </p>

      <div class="hero__actions">
        <a href={waLinks.catalog} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Request Catalog
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="#products" class="btn btn-outline">Browse Categories</a>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#products" aria-label="Scroll to product categories">
    <span aria-hidden="true"></span>
  </a>
</section>
