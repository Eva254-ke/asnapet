---
// src/components/Hero.astro
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true"></div>
  <div class="container hero__container">
    <div class="hero__content">
      <span class="eyebrow">Farm, home and daily supply</span>
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-main">Asnapet</span>
        <span class="hero__title-accent">Treasures</span>
      </h1>
      <p class="hero__subtitle">
        Quality farm inputs, household essentials and practical daily goods supplied across Nairobi with clear availability checks and direct WhatsApp support.
      </p>
      <div class="hero__actions" aria-label="Primary actions">
        <a href="https://wa.me/254707429706?text=Hello,%20I%20would%20like%20to%20request%20your%20catalog" class="btn btn-primary">Request Catalog</a>
        <a href="#products" class="btn btn-outline">Browse Categories</a>
      </div>
    </div>
  </div>
</section>
