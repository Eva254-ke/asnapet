---
import { waLinks } from '../data/site';

/**
 * ── Hero photo ─────────────────────────────────────────────────────────────
 * The source is only 474x474, well short of the ~2000px a full-bleed hero
 * wants, so no `widths` are declared: asking for upscaled variants would ship
 * bigger files without recovering any detail the source does not have. The
 * single 21KB original is served and stretched by `object-fit: cover`, sharp,
 * so the packaging stays readable as packaging.
 *
 * When a wider photograph replaces it, swap the import and add
 * `widths={[480, 768, 1200, 1600, 2000]}` with `sizes="100vw"` here — Astro
 * will then emit a real srcset instead of one stretched file.
 */
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-packaging.webp';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <div class="hero__media" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__container">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-main">Asnapet</span>
        <span class="hero__title-accent">Treasures</span>
      </h1>

      <p class="hero__tagline">Food &amp; beverage packaging supplier</p>

      <p class="hero__subtitle">
        Takeaway containers, cups, bottles, pouches, paper bags and bakery cartons for Nairobi food
        businesses &mdash; supplied plain or printed with your own branding.
      </p>

      <div class="hero__actions">
        <a href={waLinks.catalog} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Request Catalog
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="#products" class="btn btn-outline">Browse Packaging</a>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#products" aria-label="Scroll to packaging lines">
    <span aria-hidden="true"></span>
  </a>
</section>
