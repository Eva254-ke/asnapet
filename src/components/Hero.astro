---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/sheddys-hero-pasta.jpg';
import heroImageSecond from '../assets/images/sheddys-snacks.jpg';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero-slider>
  <Image
    class="hero__image is-active"
    src={heroImage}
    alt=""
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    data-hero-image="0"
  />
  <Image
    class="hero__image"
    src={heroImageSecond}
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    data-hero-image="1"
  />
  <div class="hero__media" aria-hidden="true"></div>

  <button class="hero__nav hero__nav--prev" type="button" aria-label="Previous hero slide" data-hero-prev>
    <span aria-hidden="true">&lt;</span>
  </button>
  <button class="hero__nav hero__nav--next" type="button" aria-label="Next hero slide" data-hero-next>
    <span aria-hidden="true">&gt;</span>
  </button>

  <div class="container hero__container">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-main">Asnapet</span>
        <span class="hero__title-accent">Treasures</span>
      </h1>

      <p class="hero__subtitle" data-hero-text>
        To become the leading and most trusted food and beverage distribution company in the region,
        recognized for our quality, reliability, and positive impact on local communities.
      </p>

      <div class="hero__actions">
        <a href="#products" class="btn btn-primary" data-hero-cta>Our Products</a>
      </div>
    </div>
  </div>

  <div class="hero__dots" role="tablist" aria-label="Hero slides">
    <button class="hero__dot is-active" type="button" aria-label="Show slide 1" aria-selected="true" data-hero-dot="0"></button>
    <button class="hero__dot" type="button" aria-label="Show slide 2" aria-selected="false" data-hero-dot="1"></button>
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to about section">
    <span aria-hidden="true"></span>
  </a>
</section>

<script>
  const hero = document.querySelector('[data-hero-slider]');

  if (hero) {
    const slides = [
      {
        text: 'To become the leading and most trusted food and beverage distribution company in the region, recognized for our quality, reliability, and positive impact on local communities.',
        cta: 'Our Products',
        href: '#products',
      },
      {
        text: 'To deliver quality, safe, and affordable food and beverage products to our customers while ensuring reliability, excellence, and customer satisfaction in every service we provide.',
        cta: 'About Us',
        href: '#about',
      },
    ];

    const text = hero.querySelector('[data-hero-text]');
    const cta = hero.querySelector('[data-hero-cta]');
    const prev = hero.querySelector('[data-hero-prev]');
    const next = hero.querySelector('[data-hero-next]');
    const dots = Array.from(hero.querySelectorAll('[data-hero-dot]'));
    const images = Array.from(hero.querySelectorAll('[data-hero-image]'));
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer;

    const showSlide = (index) => {
      active = (index + slides.length) % slides.length;
      const slide = slides[active];
      if (text) text.textContent = slide.text;
      if (cta) {
        cta.setAttribute('href', slide.href);
        cta.textContent = slide.cta;
      }
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === active;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });
      images.forEach((image, imageIndex) => {
        image.classList.toggle('is-active', imageIndex === active);
      });
    };

    const stopAuto = () => {
      if (timer) window.clearInterval(timer);
    };

    const startAuto = () => {
      stopAuto();
      if (!prefersReducedMotion) {
        timer = window.setInterval(() => showSlide(active + 1), 3000);
      }
    };

    prev?.addEventListener('click', () => {
      showSlide(active - 1);
      startAuto();
    });
    next?.addEventListener('click', () => {
      showSlide(active + 1);
      startAuto();
    });
    dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => {
      showSlide(dotIndex);
      startAuto();
    }));

    hero.addEventListener('mouseenter', stopAuto);
    hero.addEventListener('mouseleave', startAuto);
    hero.addEventListener('focusin', stopAuto);
    hero.addEventListener('focusout', startAuto);

    startAuto();
  }
</script>




