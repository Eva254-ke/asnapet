---
import { business } from '../data/site';
import { categories } from '../data/categories';

const quickLinks = [
  { label: 'Home', href: '/#top' },
  { label: 'About Us', href: '/#about' },
  { label: 'Our Products', href: '/#products' },
  { label: 'Testimonials', href: '/#testimonials' },
  { label: 'Why Choose Us', href: '/#why-us' },
];
---

<footer class="site-footer" id="contact">
  <div class="container site-footer__container">
    <div class="site-footer__brand-col">
      <a href="/" class="site-footer__brand"><span>Asnapet</span> <span class="site-footer__brand-accent">Treasures</span></a>
      <p class="site-footer__text">
        Through continuous innovation and technological advancement, Asnapet Treasures consistently enhances the quality and performance of our products, successfully developing a range of world-class food and beverage supply solutions designed to meet diverse business needs.
      </p>
    </div>

    <nav class="site-footer__col site-footer__nav" aria-label="Footer navigation">
      <h2 class="site-footer__label">Quick Links</h2>
      {quickLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__label">Our Products</h2>
      {categories.map((category) => <a href="/products">{category.title}</a>)}
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__label">Contact Info</h2>
      <a href={`tel:${business.phone}`}>Phone: {business.phoneDisplay}</a>
      <address class="site-footer__address">Address: {business.city} {business.countryName}</address>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} All Rights Reserved. Asnapet Treasures</p>
  </div>
</footer>
