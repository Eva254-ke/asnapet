---
import { business, waLinks } from '../data/site';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'All packaging', href: '/products' },
  { label: 'Takeaway packaging', href: '/takeaway-packaging' },
  { label: 'Why choose us', href: '/#why-us' },
  { label: 'About us', href: '/#about' },
  { label: 'FAQ', href: '/#faq' },
];
---

<footer class="site-footer" id="contact">
  <div class="container site-footer__container">
    <div class="site-footer__brand-col">
      <a href="/" class="site-footer__brand">
        <span>Asnapet</span>
        <span class="site-footer__brand-accent">Treasures</span>
      </a>
      <p class="site-footer__text">
        Registered Kenyan supplier of food and beverage packaging &mdash; plain or printed with your
        own branding.
      </p>
      <a class="site-footer__wa" href={waLinks.catalog} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M16.04 3.2c-7.04 0-12.76 5.7-12.76 12.72 0 2.24.58 4.42 1.7 6.34L3.2 28.8l6.7-1.76a12.74 12.74 0 0 0 6.12 1.56h.02c7.02 0 12.76-5.7 12.76-12.72S23.06 3.2 16.04 3.2Zm0 23.24h-.02c-1.92 0-3.8-.52-5.44-1.5l-.38-.22-3.98 1.04 1.06-3.86-.26-.4a10.48 10.48 0 0 1-1.6-5.58c0-5.84 4.76-10.58 10.62-10.58 2.84 0 5.5 1.1 7.5 3.1a10.46 10.46 0 0 1 3.12 7.48c0 5.84-4.76 10.58-10.62 10.58Z"
          />
        </svg>
        Request a catalog
      </a>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__label">Contact</h2>
      <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a>
      <a href={`mailto:${business.email}`}>{business.email}</a>
      <address class="site-footer__address">
        {business.street}<br />
        {business.city}, {business.countryName}
      </address>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__label">Opening hours</h2>
      <div class="site-footer__hours">
        <span>Mon &ndash; Fri</span><span>8:00 &ndash; 18:00</span>
        <span>Saturday</span><span>8:00 &ndash; 16:00</span>
        <span>Sunday</span><span>Closed</span>
      </div>
    </div>

    <nav class="site-footer__col site-footer__nav" aria-label="Footer navigation">
      <h2 class="site-footer__label">Explore</h2>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} {business.legalName}. All rights reserved.</p>
    {/* Read from site.ts rather than hardcoded — this line had been left saying
        "farm inputs & household essentials" after the rest of the site moved on. */}
    <p class="site-footer__built">{business.tagline}.</p>
  </div>
</footer>
