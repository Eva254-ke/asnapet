---
import { Image } from 'astro:assets';
import { categories } from '../data/categories';

const strengths = [
  {
    title: 'Local fit',
    text: 'Products are selected for Nairobi homes, farms, kiosks and small operators.',
    icon: 'pin',
  },
  {
    title: 'Stock clarity',
    text: 'We confirm availability before you commit, so you know what can be supplied.',
    icon: 'check',
  },
  {
    title: 'Practical sourcing',
    text: 'Supplier choices focus on useful quality, sensible pricing and repeat availability.',
    icon: 'box',
  },
];

const trustPoints = ['Home', 'Farm', 'Shop'];

const icons: Record<string, string> = {
  pin: 'M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Zm0-8.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z',
  check: 'M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z',
  box: 'M12 2 3 6.5v11L12 22l9-4.5v-11L12 2Zm0 2.3 6.5 3.2L12 10.7 5.5 7.5 12 4.3ZM5 9.3l6 3v7.2l-6-3V9.3Zm8 10.2v-7.2l6-3v7.2l-6 3Z',
};
---

<section class="products section-lazy" id="products" aria-labelledby="products-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Curated product lines</span>
      <h2 id="products-title">Simple categories for everyday supply needs.</h2>
      <p>
        Focused lines for households, farms and small businesses, with product choices that feel
        familiar to the local market.
      </p>
    </div>

    <div class="products__grid">
      {
        categories.map((category, index) => (
          <a
            class="category-showcase"
            href={category.href}
            aria-label={`View ${category.title}`}
            data-reveal
            data-reveal-delay={String((index % 3) + 1)}
          >
            <Image
              src={category.image}
              alt={category.alt}
              class="category-showcase__image"
              widths={[240, 400, 600, 800]}
              sizes="(max-width: 680px) 50vw, (max-width: 1080px) 50vw, 33vw"
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="category-showcase__overlay"></span>
            <span class="category-showcase__content">
              <span class="category-showcase__eyebrow">{category.eyebrow}</span>
              <span class="category-showcase__title">{category.title}</span>
              <span class="category-showcase__text">{category.description}</span>
              <span class="category-showcase__link">
                View range
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="products__cta-row" data-reveal>
      <a class="btn btn-primary products__read-more" href="/products">
        See all product lines
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<section class="why-us section-lazy" id="why-us" aria-labelledby="why-us-title">
  <div class="container why-us__container">
    <div class="section-heading section-heading--left why-us__heading" data-reveal>
      <span class="eyebrow">Why choose us</span>
      <h2 id="why-us-title">Practical local supply, made simple from first message to delivery.</h2>
      <p>
        Talk to a real person, get clear stock updates and choose products that suit your home, farm
        or business without a complicated checkout process.
      </p>

      <div class="why-us__proof" aria-label="Supply focus areas">
        {trustPoints.map((point) => <span>{point}</span>)}
      </div>
    </div>

    <div class="why-us__grid">
      {
        strengths.map((item, index) => (
          <article class="why-card" data-reveal data-reveal-delay={String(index + 1)}>
            <span class="why-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d={icons[item.icon]} fill="currentColor" />
              </svg>
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
