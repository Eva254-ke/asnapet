---
import PackShot from './PackShot.astro';
import whyImage from '../assets/images/sheddys-milk.jpg';
import { homeCategories } from '../data/categories';

const packagingSolutions = [
  'Takeaway containers',
  'Cups, lids and straws',
  'Paper bags and bakery cartons',
  'Pouches, films and branded labels',
];

const employeeContacts = [
  { name: 'Riley Kamau', role: 'Catalog support' },
  { name: 'Morgan Wanjiku', role: 'Wholesale orders' },
  { name: 'Alex Otieno', role: 'Packaging enquiries' },
];

const strengths = [
  {
    title: 'Quality Assurance',
    text: 'We distribute only trusted and certified brands.',
  },
  {
    title: 'Reliable Deliveries',
    text: 'We guarantee timely and consistent supply.',
  },
  {
    title: 'Competitive Prices',
    text: 'Affordable rates for both wholesale and retail customers.',
  },
  {
    title: 'Excellent Customer Service',
    text: 'Our team is always ready to support and respond quickly.',
  },
];
---

<section class="products section-lazy" id="products" aria-labelledby="products-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Our Products</span>
      <h2 id="products-title">Our Products</h2>
      <p>
        Asnapet Treasures specializes in distributing a wide variety of food and beverage products, including:
      </p>
    </div>

    <div class="products__grid">
      {
        homeCategories.map((category, index) => (
          <a
            class="product-card"
            href={category.href}
            aria-label={`View ${category.title}`}
            data-reveal
            data-reveal-delay={String((index % 3) + 1)}
          >
            <PackShot
              icon={category.icon}
              image={category.image}
              alt={category.alt}
              class="product-card__image"
              widths={[240, 400, 600, 800]}
              sizes="(max-width: 1080px) 50vw, 33vw"
              loading="lazy"
              tileClass={index % 2 === 1 ? 'packshot--warm' : undefined}
            />
            <span class="product-card__content">
              <span class="product-card__title">{category.title}</span>
              <span class="product-card__text">{category.description}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="products__support" data-reveal>
      <div class="products__support-panel products__support-panel--accent">
        <span class="products__support-label">Packaging solutions</span>
        <h3>Food service packaging available with your product order.</h3>
        <div class="products__chips">
          {packagingSolutions.map((item) => <span>{item}</span>)}
        </div>
      </div>

      <div class="products__support-panel">
        <span class="products__support-label">Team contacts</span>
        <h3>Ask the right desk for a faster response.</h3>
        <div class="products__people">
          {
            employeeContacts.map((person) => (
              <span>
                <strong>{person.name}</strong>
                <small>{person.role}</small>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="products__cta-row" data-reveal>
      <a class="btn btn-primary products__read-more" href="/products">
        Read More
      </a>
    </div>
  </div>
</section>

<section class="why-us section-lazy" id="why-us" aria-labelledby="why-us-title" style={`--why-bg: url(${whyImage.src})`}>
  <div class="why-us__overlay" aria-hidden="true"></div>
  <div class="container why-us__container">
    <div class="why-us__card" data-reveal>
      <h2 id="why-us-title">Why Choose Asnapet Treasures</h2>

      <div class="why-us__list">
        {
          strengths.map((item) => (
            <article class="why-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>

      <a class="btn btn-primary why-us__read-more" href="/products">
        Read More
      </a>
    </div>
  </div>
</section>
