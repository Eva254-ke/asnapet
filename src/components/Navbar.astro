---
import { business, waLinks } from '../data/site';

const links = [
  { label: 'Products', href: '/#products' },
  { label: 'Why Us', href: '/#why-us' },
  { label: 'Household', href: '/household' },
  { label: 'About', href: '/#about' },
  { label: 'FAQ', href: '/#faq' },
];
---

<nav class="navbar" id="site-nav" aria-label="Primary navigation">
  <div class="navbar__announcement">
    <div class="container navbar__announcement-inner">
      {/* Two variants rather than one wrapping line: on a phone the strip has
          to stay on a single row to keep its height down, and "Nairobi" is the
          word that can go — the city is already stated all over the page. Only
          one is ever rendered (the other is display:none, so it is out of the
          accessibility tree too). */}
      <span class="navbar__announcement-full">
        Free Nairobi delivery over {business.freeDeliveryThreshold}
      </span>
      <span class="navbar__announcement-short">
        Free delivery over {business.freeDeliveryThreshold}
      </span>
      <a href={`tel:${business.phone}`}>Call {business.phoneDisplay}</a>
    </div>
  </div>

  <div class="navbar__main">
    <div class="container navbar__container">
      <a href="/" class="navbar__logo" aria-label={`${business.name} home`}>
        <span class="navbar__brand-word navbar__brand-word--primary">Asnapet</span>
        <span class="navbar__brand-word navbar__brand-word--accent">Treasures</span>
      </a>

      <ul class="navbar__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__actions">
        <a href={waLinks.catalog} class="navbar__cta" target="_blank" rel="noopener noreferrer">
          Request Catalog
        </a>
        <button
          class="navbar__mobile-toggle"
          id="mobile-menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="navbar__icon-open" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg class="navbar__icon-close" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="navbar__mobile-menu" id="mobile-menu">
    <div class="container">
      <ul class="navbar__mobile-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href={waLinks.catalog} target="_blank" rel="noopener noreferrer">Request Catalog</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // Prevent the page scrolling behind the open panel.
      document.body.classList.toggle('has-menu-open', open);
    };

    btn.addEventListener('click', () => {
      setOpen(!menu.classList.contains('is-open'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Escape closes the panel and returns focus to the toggle.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });

    // Close when the viewport grows past the breakpoint that hides the toggle,
    // otherwise the panel stays open but invisible and traps focus.
    const desktop = window.matchMedia('(min-width: 820px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Condense the navbar once the user scrolls past the announcement bar.
  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 24);
    };

    // Apply the correct state first, then enable transitions on the next frame.
    // Reloading a scrolled page would otherwise paint the expanded navbar and
    // animate it shut, which reads as a loading glitch.
    onScroll();
    requestAnimationFrame(() => {
      requestAnimationFrame(() => nav.classList.add('is-ready'));
    });

    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
