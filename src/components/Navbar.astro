---
import { business } from '../data/site';

const links = [
  { label: 'Home', href: '/#top' },
  { label: 'About Us', href: '/#about' },
  { label: 'Why Choose Us', href: '/#why-us' },
  { label: 'Our Products', href: '/#products' },
  { label: 'Testimonials', href: '/#testimonials' },
  { label: 'Contact Us', href: '/#contact' },
];
---

<nav class="navbar" id="site-nav" aria-label="Primary navigation">
  <div class="navbar__announcement">
    <div class="container navbar__announcement-inner">
      <span>Contacts: {business.phoneDisplay}</span>
    </div>
  </div>

  <div class="navbar__main">
    <div class="container navbar__container">
      <a href="/" class="navbar__logo" aria-label={`${business.name} home`}>
        <span class="navbar__brand-word navbar__brand-word--primary">Asnapet</span>
        <span class="navbar__brand-word navbar__brand-word--accent">Treasures</span>
      </a>

      <ul class="navbar__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>

      <div class="navbar__actions">
        <button
          class="navbar__mobile-toggle"
          id="mobile-menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="navbar__icon-open" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg class="navbar__icon-close" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="navbar__mobile-menu" id="mobile-menu">
    <div class="container">
      <ul class="navbar__mobile-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('has-menu-open', open);
    };

    btn.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });

    const desktop = window.matchMedia('(min-width: 820px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  if (nav) {
    const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.add('is-ready')));
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

