---
import { Image } from 'astro:assets';
import aboutImage from '../assets/images/sheddys-snacks.jpg';
---

<section class="about section-lazy" id="about" aria-labelledby="about-title">
  <div class="container about__container">
    <div class="about__content" data-reveal>
      <h2 class="about__title" id="about-title">About Us</h2>
      <p class="about__text">
        Asnapet Treasures is a proud international food &amp; beverage company importing from Asia and other East African countries.<br />
        We supply supermarkets, wholesalers, retailers, hotels, and restaurants with trusted food and beverage brands that meet both local and international standards.
      </p>
      <a href="/products" class="about__button">Read More</a>
    </div>

    <div class="about__image-wrap" data-reveal data-reveal-delay="1">
      <Image
        src={aboutImage}
        alt="Assortment of packaged snacks"
        widths={[400, 640, 980, 1280]}
        sizes="(max-width: 980px) 100vw, 40vw"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

