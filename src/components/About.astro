---
import { Image } from 'astro:assets';
import aboutImage from '../assets/images/about-agriculture.jpg';

const facts = [
  {
    title: 'Supplier checks',
    text: 'Products are sourced through trusted manufacturers and distributors.',
  },
  {
    title: 'Clear records',
    text: 'Every confirmed purchase is handled with straightforward communication and receipts.',
  },
  {
    title: 'Delivery support',
    text: 'Practical dispatch coordination for Nairobi households and businesses.',
  },
];
---

<section class="about section-lazy" id="about" aria-labelledby="about-title">
  <div class="container about__container">
    <div class="about__image-wrap" data-reveal>
      <Image
        src={aboutImage}
        alt="Sunlit agricultural field with healthy crops in Kenya"
        widths={[400, 640, 736]}
        sizes="(max-width: 980px) 100vw, 40vw"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about__content" data-reveal data-reveal-delay="1">
      <span class="eyebrow">About Asnapet</span>
      <h2 class="about__title" id="about-title">
        A dependable sourcing partner for homes, farms and local operators.
      </h2>
      <p class="about__text">
        Asnapet Treasures is a registered Kenyan enterprise supplying agricultural inputs and
        household essentials through verified supplier relationships.
      </p>
      <p class="about__text">
        We keep the service practical: confirm what you need, share current availability, issue
        receipts and coordinate delivery within Nairobi.
      </p>

      <div class="about__facts" aria-label="Business strengths">
        {
          facts.map((fact) => (
            <div class="about__fact-item">
              <h3>{fact.title}</h3>
              <p>{fact.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
