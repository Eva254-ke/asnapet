---
// src/components/About.astro
---

<section class="about section-lazy" id="about" aria-labelledby="about-title">
  <div class="container about__container">
    <div class="about__image-wrap">
      <img src="/images/about-agriculture.jpg" alt="Sunlit agricultural field with healthy crops" loading="lazy" decoding="async" width="736" height="416" />
    </div>

    <div class="about__content">
      <span class="eyebrow">About Asnapet</span>
      <h2 class="about__title" id="about-title">A dependable sourcing partner for homes, farms and local operators.</h2>
      <p class="about__text">
        Asnapet Treasures is a registered Kenyan enterprise supplying agricultural inputs and household essentials through verified supplier relationships.
      </p>
      <p class="about__text">
        We keep the service practical: confirm what you need, share current availability, issue receipts and coordinate delivery within Nairobi.
      </p>

      <div class="about__facts" aria-label="Business strengths">
        <div class="about__fact-item">
          <h3>Supplier checks</h3>
          <p>Products are sourced through trusted manufacturers and distributors.</p>
        </div>
        <div class="about__fact-item">
          <h3>Clear records</h3>
          <p>Every confirmed purchase is handled with straightforward communication and receipts.</p>
        </div>
        <div class="about__fact-item">
          <h3>Delivery support</h3>
          <p>Practical dispatch coordination for Nairobi households and businesses.</p>
        </div>
      </div>
    </div>
  </div>
</section>
