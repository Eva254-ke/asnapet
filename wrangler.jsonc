{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "asnapet",
	"compatibility_date": "2026-07-27",

	// This site is fully prerendered — there is no `main` (no Worker script),
	// so Cloudflare serves `dist/` straight from the edge asset store.
	//
	// Deliberately NOT using @astrojs/cloudflare: adding an adapter makes Astro
	// defer image optimisation to a runtime `/_image` endpoint, which cannot run
	// `sharp` on Workers. Without an adapter, images are optimised at build time
	// and emitted as real files under `/_astro/`.
	"assets": {
		"directory": "./dist",

		// `astro.config.mjs` sets `build.format: 'file'` + `trailingSlash: 'never'`,
		// so pages land on disk as `/products.html`. `auto-trailing-slash` resolves
		// a request for `/products` to that file and redirects `/products/` to it.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},

	"observability": {
		"enabled": true
	}
}
